<footer class="container mx-auto px-4 max-w-5xl mt-16 mb-8">
  <div class="bg-card border border-border p-8 rounded-2xl shadow-sm text-center">
    <div class="mb-6">
      <h3 class="text-xl font-bold mb-2">Ease IP</h3>
      <p class="text-sm text-foreground-secondary max-w-md mx-auto mb-4">
        Ease IP provides patent engineering services to licensed U.S. practitioners. We assist with patent drafting and prosecution support to ensure high-quality applications.
      </p>
      <p class="text-xs text-muted-foreground/80 max-w-md mx-auto">
        📍 3532 N. Franklin St, Suite A, Denver, CO 80205
      </p>
    </div>
    
    <!-- Navigation Links -->
    <div class="flex flex-wrap justify-center items-center gap-2 sm:gap-3 mt-6">
      <a href="/terms" style="border-color: var(--brand-500); color: var(--brand-500);" class="px-4 py-2 rounded-xl border hover:opacity-80 text-xs sm:text-sm font-bold transition-all">Terms of Use</a>
      <a href="/privacy" style="border-color: var(--brand-500); color: var(--brand-500);" class="px-4 py-2 rounded-xl border hover:opacity-80 text-xs sm:text-sm font-bold transition-all">Privacy Policy</a>
      <a href="/contact" style="background-color: var(--brand-500); color: #ffffff;" class="px-4 py-2 rounded-xl font-extrabold text-xs sm:text-sm transition-all hover:opacity-90 active:scale-[0.96] shadow-sm">Contact Us</a>
    </div>
    
    <div class="mt-8 text-xs text-muted-foreground/70">
      &copy; {new Date().getFullYear()} Ease IP. All rights reserved.
    </div>
  </div>
</footer>
